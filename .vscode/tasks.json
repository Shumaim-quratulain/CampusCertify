{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run CampusCertify",
			"type": "shell",
			"command": "./mvnw",
			"args": [
				"spring-boot:run"
			],
			"isBackground": true,
			"problemMatcher": {
				"pattern": {
					"regexp": "^ERROR",
					"file": 1,
					"location": 1,
					"message": 1
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^.*Starting CampuscertifyApplication.*$",
					"endsPattern": "^.*(Started CampuscertifyApplication|APPLICATION FAILED TO START).*$"
				}
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		}
	]
}
